# ─── Telegram ────────────────────────────────────────────────────────────────
# توکن ربات تلگرام — از @BotFather دریافت کنید
BOT_TOKEN=

# شناسه عددی تلگرام مالک — از @userinfobot دریافت کنید
# برای دریافت پیام‌های صبح/شب روزانه لازم است
OWNER_ID=

# ─── Database ────────────────────────────────────────────────────────────────
# مسیر فایل SQLite
# برای Railway توصیه می‌شود: /app/data/icebox.db
DB_PATH=./data/icebox.db

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=production
