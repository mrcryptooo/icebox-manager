# ─── Telegram ────────────────────────────────────────────────────────────────
# توکن ربات تلگرام — از @BotFather دریافت کنید
BOT_TOKEN=

# شناسه عددی تلگرام مالک — از @userinfobot دریافت کنید
# برای دریافت پیام‌های صبح/شب روزانه لازم است
OWNER_ID=

# ─── Database ────────────────────────────────────────────────────────────────
# آدرس اتصال PostgreSQL
# برای توسعه محلی: postgresql://user:password@localhost:5432/icebox
# برای Railway: به‌صورت خودکار توسط Railway تنظیم می‌شود
DATABASE_URL=

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=production
